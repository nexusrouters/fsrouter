{
  "name": "@fudrouter/fsrouter",
  "version": "0.6.258",
  "description": "9Router v2 — Monorepo (frontend + backend)",
  "workspaces": [
    "frontend",
    "backend",
    "backend/open-sse"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "zod": "4.0.0",
    "open": "*",
    "ora": "*",
    "chalk-animation": "*",
    "figlet": "*",
    "gradient-string": "*",
    "boxen": "*",
    "inquirer": "*",
    "node-machine-id": "*",
    "bcryptjs": "*",
    "confbox": "*",
    "sql.js": "*",
    "undici": "*",
    "uuid": "*"
  },
  "bin": {
    "amrouter": "bin/cli.cjs",
    "fsrouter": "bin/cli.cjs"
  },
  "files": [
    "dist",
    "public",
    "automation",
    "bin",
    "package.json",
    "README.md",
    "LICENSE"
  ]
}
